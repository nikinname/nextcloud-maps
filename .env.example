NEXTCLOUD_URL=https://nextcloud.example.org
ADMIN_NC_USERNAME=utente
NEXTCLOUD_BASE_PATH=/Photos
NEXTCLOUD_EXCLUDE_PATHS=
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.heic,.webp

POSTGRES_DB=photomap
POSTGRES_USER=photomap
POSTGRES_PASSWORD=photomap
DATABASE_URL=postgresql://photomap:photomap@db:5432/photomap

APP_BASE_URL=https://localhost:8443
APP_SECRET_KEY=change-this-to-a-long-random-secret
THUMBNAIL_CACHE_DIR=/data/thumbnails
SCAN_INTERVAL_HOURS=24

# HTTPS frontend
# CERT_MODE=selfsigned uses a generated local certificate.
# CERT_MODE=letsencrypt requests a certificate through HTTP-01; HTTP_PORT must be reachable as public port 80.
CERT_MODE=selfsigned
PUBLIC_HOSTNAME=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
LETSENCRYPT_EMAIL=

MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_DEFAULT_LAT=43.837
MAP_DEFAULT_LON=11.195
MAP_DEFAULT_ZOOM=10
